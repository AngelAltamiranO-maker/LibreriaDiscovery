@model IEnumerable<LibreriaDiscovery.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Libros";
}

<div class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
    
    <!-- Encabezado del Catálogo -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-200 pb-6">
        <div>
            <span class="bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">
                Inventario General
            </span>
            <h1 class="text-3xl font-black text-gray-900 tracking-tight mt-2">Catálogo de Libros</h1>
            <p class="text-gray-500 text-sm mt-1">Explora todos los títulos disponibles en nuestra base de datos.</p>
        </div>
    </div>

    <!-- Barra de Búsqueda y Filtros -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <form method="get" class="flex flex-col sm:flex-row gap-4">
            <div class="relative flex-grow">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">🔍</span>
                <input type="text" name="q" placeholder="Buscar por título..." value="@Context.Request.Query["q"]"
                       class="pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:bg-white focus:outline-none w-full text-sm">
            </div>
            
            <select name="marca" class="px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:bg-white focus:outline-none text-sm">
                <option value="">📚 Todas las editoriales</option>
                @if (ViewBag.Marcas != null)
                {
                    foreach (var marca in ViewBag.Marcas)
                    {
                        var isSelected = Context.Request.Query["marca"] == marca.Id.ToString() ? "selected" : null;
                        <option value="@marca.Id" selected="@isSelected">@marca.Nombre</option>
                    }
                }
            </select>

            <button type="submit" class="bg-gray-900 text-white px-7 py-3 rounded-xl font-semibold hover:bg-emerald-600 transition text-sm shadow-sm">
                Filtrar
            </button>
        </form>
    </div>

    <!-- Cuadrícula de Libros -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        @foreach (var producto in Model)
        {
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 p-5 flex flex-col justify-between border border-gray-100 group">
                <div>
                    <!-- Tarjeta visual superior con diseño elegante -->
                    <div class="w-full h-44 bg-gradient-to-br from-gray-900 via-slate-900 to-emerald-950 rounded-xl mb-4 flex flex-col items-center justify-center text-white p-4 relative overflow-hidden shadow-inner">
                        <span class="absolute top-3 right-3 bg-white/10 backdrop-blur-md text-emerald-300 text-[10px] font-bold px-2.5 py-1 rounded-full border border-emerald-500/20">
                            @producto.Marca?.Nombre
                        </span>
                        <div class="text-3xl mb-1">📖</div>
                        <span class="text-xs font-semibold text-gray-300 tracking-wider uppercase">Discovery Edition</span>
                    </div>

                    <h3 class="font-bold text-gray-900 text-base group-hover:text-emerald-600 transition line-clamp-1 mb-1">@producto.Nombre</h3>
                    <div class="flex items-center gap-2 text-xs text-gray-500 mb-4">
                        <span class="w-2 h-2 rounded-full @(producto.Stock > 0 ? "bg-emerald-500" : "bg-rose-500")"></span>
                        <span>Stock: <strong class="text-gray-700">@producto.Stock</strong> unidades</span>
                    </div>
                </div>

                <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                    <div>
                        <span class="text-[10px] text-gray-400 block uppercase font-bold tracking-wider">Precio</span>
                        <span class="text-xl font-black text-emerald-600">$@producto.Precio.ToString("0.00")</span>
                    </div>
                    
                    <div class="flex gap-2">
                        <a asp-controller="Productos" asp-action="Details" asp-route-id="@producto.Id" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-xl text-xs font-semibold transition">
                            Detalle
                        </a>
                        <form asp-controller="Carrito" asp-action="Agregar" asp-route-id="@producto.Id" method="post">
                            <button type="submit" class="bg-emerald-50 hover:bg-emerald-600 text-emerald-700 hover:text-white px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1 border border-emerald-100 shadow-xs">
                                <span>+</span> Comprar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

</div>