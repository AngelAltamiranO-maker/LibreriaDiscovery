@model LibreriaDiscovery.Models.Usuario
@{
    ViewData["Title"] = "Registro de Usuario";
}

<div class="max-w-md mx-auto mt-10 bg-white dark:bg-slate-800 p-8 rounded-xl shadow-md border border-slate-200 dark:border-slate-700">
    <h2 class="text-2xl font-bold text-center text-slate-800 dark:text-white mb-6">Crear Cuenta</h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="mb-4 p-3 bg-green-100 border border-green-400 text-green-700 rounded text-sm">
            @TempData["Mensaje"]
        </div>
    }

    <form asp-action="Registro" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-2"></div>

        <div>
            <label asp-for="Nombre" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Nombre Completo</label>
            <input asp-for="Nombre" class="w-full px-3 py-2 border rounded-lg dark:bg-slate-900 dark:border-slate-600 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Tu nombre" />
            <span asp-validation-for="Nombre" class="text-red-500 text-xs"></span>
        </div>

        <div>
            <label asp-for="Correo" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Correo Electrónico</label>
            <input asp-for="Correo" class="w-full px-3 py-2 border rounded-lg dark:bg-slate-900 dark:border-slate-600 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="tu@correo.com" />
            <span asp-validation-for="Correo" class="text-red-500 text-xs"></span>
        </div>

        <div>
            <label asp-for="PasswordHash" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Contraseña</label>
            <input asp-for="PasswordHash" type="password" class="w-full px-3 py-2 border rounded-lg dark:bg-slate-900 dark:border-slate-600 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="••••••••" />
            <span asp-validation-for="PasswordHash" class="text-red-500 text-xs"></span>
        </div>

        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-200">
            Registrarse
        </button>
    </form>

    <p class="text-center text-sm text-slate-600 dark:text-slate-400 mt-4">
        ¿Ya tienes cuenta? <a asp-action="Login" class="text-indigo-600 dark:text-indigo-400 font-semibold hover:underline">Inicia sesión</a>
    </p>
</div>