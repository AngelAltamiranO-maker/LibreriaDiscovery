@model IEnumerable<LibreriaDiscovery.Controllers.CarritoController.ItemCarrito>

<div class="max-w-4xl mx-auto py-8 px-4">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Tu Carrito de Compras</h2>

    @if (Model != null && Model.Any())
    {
        <div class="bg-white dark:bg-slate-800 shadow-xl rounded-2xl overflow-hidden border border-slate-100 dark:border-slate-700">
            <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
                <thead class="bg-slate-50 dark:bg-slate-900">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Libro</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-slate-500 uppercase">Cantidad</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase">Subtotal</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900 dark:text-white">
                                @item.Titulo
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
                                <div class="inline-flex items-center space-x-2">
                                    <!-- Botón disminuir -->
                                    <form asp-action="Disminuir" asp-route-id="@item.LibroId" method="post">
                                        <button type="submit" class="px-2 py-1 bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-white rounded-lg text-xs font-bold hover:bg-slate-300 transition">-</button>
                                    </form>
                                    
                                    <span class="px-2 font-semibold text-slate-800 dark:text-white">@item.Cantidad</span>

                                    <!-- Botón aumentar -->
                                    <form asp-action="Agregar" asp-route-id="@item.LibroId" method="post">
                                        <button type="submit" class="px-2 py-1 bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-white rounded-lg text-xs font-bold hover:bg-slate-300 transition">+</button>
                                    </form>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-slate-600 dark:text-slate-300">
                                $@item.Subtotal.ToString("N2")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <!-- Botón eliminar por completo -->
                                <form asp-action="Eliminar" asp-route-id="@item.LibroId" method="post">
                                    <button type="submit" class="text-red-600 dark:text-red-400 hover:underline text-xs">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
            <div class="p-6 bg-slate-50 dark:bg-slate-900/50 flex justify-between items-center border-t border-slate-200 dark:border-slate-700">
                <span class="text-lg font-bold text-slate-900 dark:text-white">Total a Pagar:</span>
                <span class="text-lg font-bold text-indigo-600 dark:text-indigo-400">
                    $@Model.Sum(x => x.Subtotal).ToString("N2")
                </span>
                <a href="#" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-semibold shadow-sm transition">
                    Proceder al Pago
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-16 bg-white dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/50 rounded-2xl shadow-sm">
            <p class="text-slate-600 dark:text-slate-400 text-sm font-medium">Tu carrito está vacío.</p>
            <a asp-controller="Home" asp-action="Index" class="mt-4 inline-block px-4 py-2 bg-indigo-600 text-white rounded-xl text-xs font-semibold">Ver catálogo</a>
        </div>
    }
</div>