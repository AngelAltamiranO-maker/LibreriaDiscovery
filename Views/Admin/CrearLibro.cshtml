@model LibreriaDiscovery.Models.Libro
@{
    ViewData["Title"] = "Agregar Nuevo Libro";
}

<div class="max-w-md mx-auto mt-10 bg-white dark:bg-slate-800 p-8 rounded-xl shadow-md border border-slate-200 dark:border-slate-700">
    <h2 class="text-2xl font-bold text-center text-slate-800 dark:text-white mb-6">Agregar Libro</h2>

    <form asp-action="CrearLibro" method="post" class="space-y-4">
        <div>
            <label asp-for="Titulo" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Título</label>
            <input asp-for="Titulo" class="w-full px-3 py-2 border rounded-lg dark:bg-slate-900 dark:border-slate-600 dark:text-white" required />
        </div>

        <div>
            <label asp-for="Autor" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Autor</label>
            <input asp-for="Autor" class="w-full px-3 py-2 border rounded-lg dark:bg-slate-900 dark:border-slate-600 dark:text-white" required />
        </div>

        <div>
            <label asp-for="Precio" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Precio</label>
            <input asp-for="Precio" type="number" step="0.01" class="w-full px-3 py-2 border rounded-lg dark:bg-slate-900 dark:border-slate-600 dark:text-white" required />
        </div>

        <div>
            <label asp-for="Stock" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Stock</label>
            <input asp-for="Stock" type="number" class="w-full px-3 py-2 border rounded-lg dark:bg-slate-900 dark:border-slate-600 dark:text-white" required />
        </div>

        <div>
            <label asp-for="ImagenUrl" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">URL de la Imagen</label>
            <input asp-for="ImagenUrl" class="w-full px-3 py-2 border rounded-lg dark:bg-slate-900 dark:border-slate-600 dark:text-white" placeholder="https://..." />
        </div>

        <div class="flex justify-between items-center pt-2">
            <a asp-action="Index" class="text-slate-600 dark:text-slate-400 text-sm hover:underline">Cancelar</a>
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg">
                Guardar Libro
            </button>
        </div>
    </form>
</div>