@model IEnumerable<LibreriaDiscovery.Models.Libro>
@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="max-w-6xl mx-auto mt-8 px-4">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-slate-800 dark:text-white">Panel de Administración</h1>
        <a asp-action="CrearLibro" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg font-semibold transition">
            + Nuevo Libro
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="mb-4 p-3 bg-green-100 border border-green-400 text-green-700 rounded text-sm">
            @TempData["Mensaje"]
        </div>
    }

    <div class="bg-white dark:bg-slate-800 shadow-md rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700">
        <table class="w-full text-left border-collapse">
            <thead class="bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-sm uppercase">
                <tr>
                    <th class="p-4">Título</th>
                    <th class="p-4">Autor</th>
                    <th class="p-4">Precio</th>
                    <th class="p-4">Stock</th>
                    <th class="p-4 text-center">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-700 text-slate-700 dark:text-slate-300">
                @foreach (var libro in Model)
                {
                    <tr>
                        <td class="p-4 font-medium">@libro.Titulo</td>
                        <td class="p-4">@libro.Autor</td>
                        <td class="p-4">$@libro.Precio.ToString("N2")</td>
                        <td class="p-4">@libro.Stock</td>
                        <td class="p-4 text-center">
                            <form asp-action="EliminarLibro" asp-route-id="@libro.Id" method="post" class="inline">
                                <button type="submit" onclick="return confirm('¿Estás seguro de eliminar este libro?');" class="text-red-500 hover:text-red-700 font-semibold text-sm">
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>