@{
    ViewData["Title"] = "Sobre Nosotros";
}

<div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-12">
    
    <!-- Encabezado de la Sección -->
    <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full mb-4">
            🌱 Nuestra Filosofía
        </span>
        
        <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-4">
            Acerca de Librería Discovery
        </h1>
        
        <p class="text-gray-600 text-base sm:text-lg leading-relaxed font-normal">
            Fundada con la misión de conectar mentes curiosas con el conocimiento infinito de la literatura global y técnica. Creemos que cada página leída es un paso hacia la inspiración, la innovación y el autodescubrimiento.
        </p>
    </div>

    <!-- Cuadrícula de Tarjetas (Misión, Visión, Valores) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Nuestra Misión -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between transition hover:shadow-md">
            <div>
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl mb-6 font-bold shadow-xs border border-emerald-100">
                    🎯
                </div>
                <h3 class="font-bold text-gray-900 text-lg mb-3">Nuestra Misión</h3>
                <p class="text-gray-500 text-sm leading-relaxed">
                    Democratizar el acceso a la literatura técnica, científica y recreativa a través de una plataforma digital eficiente y amigable.
                </p>
            </div>
        </div>

        <!-- Nuestra Visión -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between transition hover:shadow-md">
            <div>
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl mb-6 font-bold shadow-xs border border-emerald-100">
                    👁️
                </div>
                <h3 class="font-bold text-gray-900 text-lg mb-3">Nuestra Visión</h3>
                <p class="text-gray-500 text-sm leading-relaxed">
                    Ser la librería digital preferida por estudiantes, profesionales y lectores apasionados en toda la región.
                </p>
            </div>
        </div>

        <!-- Valores -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between transition hover:shadow-md">
            <div>
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl mb-6 font-bold shadow-xs border border-emerald-100">
                    💚
                </div>
                <h3 class="font-bold text-gray-900 text-lg mb-3">Valores</h3>
                <p class="text-gray-500 text-sm leading-relaxed">
                    Pasión por la lectura, integridad en el servicio, compromiso con nuestros lectores y mejora continua en cada entrega.
                </p>
            </div>
        </div>

    </div>

</div>