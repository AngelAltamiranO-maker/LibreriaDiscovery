@model LibreriaDiscovery.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<div class="max-w-2xl mx-auto px-4 py-8">
    <div class="bg-white dark:bg-slate-800 shadow-xl rounded-2xl p-6 border border-gray-100 dark:border-slate-700">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Editar Libro</h1>

        <form asp-action="Edit" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>
            <input type="hidden" asp-for="Id" />

            <div>
                <label asp-for="Titulo" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Título</label>
                <input asp-for="Titulo" class="mt-1 block w-full px-4 py-2 bg-gray-50 dark:bg-slate-900 border border-gray-300 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span asp-validation-for="Titulo" class="text-red-500 text-xs"></span>
            </div>

            <div>
                <label asp-for="Autor" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Autor</label>
                <input asp-for="Autor" class="mt-1 block w-full px-4 py-2 bg-gray-50 dark:bg-slate-900 border border-gray-300 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span asp-validation-for="Autor" class="text-red-500 text-xs"></span>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="Precio" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Precio ($)</label>
                    <input asp-for="Precio" type="number" step="0.01" class="mt-1 block w-full px-4 py-2 bg-gray-50 dark:bg-slate-900 border border-gray-300 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="Precio" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Stock" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Stock</label>
                    <input asp-for="Stock" type="number" class="mt-1 block w-full px-4 py-2 bg-gray-50 dark:bg-slate-900 border border-gray-300 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="Stock" class="text-red-500 text-xs"></span>
                </div>
            </div>

            <div>
                <label asp-for="ImagenUrl" class="block text-sm font-medium text-gray-700 dark:text-gray-300">URL de la Imagen</label>
                <input asp-for="ImagenUrl" class="mt-1 block w-full px-4 py-2 bg-gray-50 dark:bg-slate-900 border border-gray-300 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span asp-validation-for="ImagenUrl" class="text-red-500 text-xs"></span>
            </div>

            <div>
                <label asp-for="Descripcion" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Descripción</label>
                <textarea asp-for="Descripcion" rows="3" class="mt-1 block w-full px-4 py-2 bg-gray-50 dark:bg-slate-900 border border-gray-300 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
                <span asp-validation-for="Descripcion" class="text-red-500 text-xs"></span>
            </div>

            <div class="flex justify-end space-x-3 pt-4">
                <a asp-action="Index" class="px-4 py-2 bg-gray-200 dark:bg-slate-700 text-gray-700 dark:text-gray-300 font-medium rounded-xl hover:bg-gray-300 dark:hover:bg-slate-600 transition-colors">Cancelar</a>
                <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl shadow-lg shadow-indigo-500/20 transition-all">Actualizar</button>
            </div>
        </form>
    </div>
</div>